# Copy to .env and fill in (never commit .env)
CV_PASSWORD=
# Optional override for /worlding (defaults to CV_PASSWORD)
# WORLDING_PASSWORD=

# CV workflow:
# 1. Put plaintext HTML in cv/private/content.html
# 2. Put PDFs (and other files) next to it under cv/private/
# 3. In content.html reference them as asset:filename.pdf
#    (use data-pdf="asset:…" on .cv-pdf for embedded preview)
# 4. After any password change, re-encrypt: npm run encrypt-cv
#    (.env is loaded automatically; runtime still uses the encrypted payload)
# 5. Commit cv/payload.json + cv/enc/ (never cv/private/)

# Worlding workflow:
# 1. Edit plaintext in apps/worlding/frontend/ (submodule)
# 2. Re-encrypt: npm run encrypt-worlding
#    Password: WORLDING_PASSWORD or CV_PASSWORD from .env
# 3. Commit worlding/payload.json + worlding/enc/ (+ worlding/index.html if changed)
# 4. Build only copies worlding/ → dist/worlding (no password needed on Vercel)
